  {
    "id": "count-connected-components",
    "title": "Count Connected Components",
    "pattern": "graph-traversal",
    "difficulty": "Easy",
    "description": "You are given n nodes labeled from 0 to n-1 and a list of undirected edges, where each edge is [u, v]. Return the number of connected components in the graph. Two nodes are in the same component if there is a path between them.",
    "examples": [
      {
        "input": "n = 5, edges = [[0,1],[1,2],[3,4]]",
        "output": "2",
        "explanation": "The components are {0, 1, 2} and {3, 4}."
      },
      {
        "input": "n = 5, edges = [[0,1],[1,2],[2,3],[3,4]]",
        "output": "1",
        "explanation": "All nodes are connected into one component."
      }
    ],
    "constraints": [
      "1 <= n <= 1000",
      "0 <= edges.length <= 10^4",
      "0 <= u, v < n"
    ],
    "signature": {
      "className": "Solution",
      "methodName": "countComponents",
      "returnType": "int",
      "params": [
        {
          "name": "n",
          "type": "int"
        },
        {
          "name": "edges",
          "type": "int[][]"
        }
      ]
    },
    "starterCode": "class Solution {\n    public int countComponents(int n, int[][] edges) {\n        return 0;\n    }\n}",
    "sampleTests": [
      {
        "input": "5\n[[0, 1], [1, 2], [3, 4]]",
        "expected": "2"
      },
      {
        "input": "5\n[[0, 1], [1, 2], [2, 3], [3, 4]]",
        "expected": "1"
      }
    ],
    "hiddenTests": [
      {
        "input": "1\n[]",
        "expected": "1"
      },
      {
        "input": "4\n[]",
        "expected": "4"
      },
      {
        "input": "6\n[[0, 1], [2, 3], [4, 5]]",
        "expected": "3"
      },
      {
        "input": "3\n[[0, 1], [1, 2], [0, 2]]",
        "expected": "1"
      },
      {
        "input": "7\n[[0, 1], [1, 2], [3, 4]]",
        "expected": "4"
      }
    ],
    "tags": [
      "graph",
      "dfs",
      "bfs",
      "union-find"
    ],
    "timeComplexity": "O(n + e)",
    "spaceComplexity": "O(n + e)",
    "hints": [
      "Start a graph search from any unvisited node and mark everything you can reach.",
      "Each time you start a new search from an unvisited node, you have found one more component.",
      "Union-Find also works: union every edge, then count distinct roots."
    ]
  },

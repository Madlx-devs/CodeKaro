        "input": "[2, 7, 11, 15]\n9",
        "expected": "[0, 1]"
      },
      {
        "input": "[3, 2, 4]\n6",
        "expected": "[1, 2]"
      }
    ],
    "hiddenTests": [
      {
        "input": "[3, 3]\n6",
        "expected": "[0, 1]"
      },
      {
        "input": "[-1, -2, -3, -4, -5]\n-8",
        "expected": "[2, 4]"
      },
      {
        "input": "[0, 4, 3, 0]\n0",
        "expected": "[0, 3]"
      },
      {
        "input": "[2, 5, 5, 11]\n10",
        "expected": "[1, 2]"
      },

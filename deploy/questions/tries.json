  {
    "id": "prefix-count-queries",
    "title": "Prefix Count Queries",
    "pattern": "tries",
    "difficulty": "Easy",
    "description": "You are given an array of words and an array of query strings. For each query, return how many words start with that query string.",
    "examples": [
      {
        "input": "words = [\"apple\",\"app\",\"application\",\"banana\"], queries = [\"app\",\"ban\",\"a\"]",
        "output": "[3, 1, 3]",
        "explanation": "\"app\" matches 3 words, \"ban\" matches 1, \"a\" matches 3."
      },
      {
        "input": "words = [\"a\",\"aa\",\"aaa\"], queries = [\"a\",\"aaaa\"]",
        "output": "[3, 0]",
        "explanation": "\"a\" matches 3 words; \"aaaa\" matches none."
      }
    ],
    "constraints": [
      "0 <= words.length, queries.length <= 1000"
    ],
    "signature": {
      "className": "Solution",
      "methodName": "prefixCount",
      "returnType": "int[]",
      "params": [
        {
          "name": "words",
          "type": "String[]"
        },
        {
          "name": "queries",
          "type": "String[]"
        }
      ]
    },
    "starterCode": "class Solution {\n    public int[] prefixCount(String[] words, String[] queries) {\n        return new int[0];\n    }\n}",
    "sampleTests": [
      {
        "input": "[\"apple\", \"app\", \"application\", \"banana\"]\n[\"app\", \"ban\", \"a\"]",
        "expected": "[3, 1, 3]"
      },
      {
        "input": "[\"a\", \"aa\", \"aaa\"]\n[\"a\", \"aa\", \"aaa\", \"aaaa\"]",
        "expected": "[3, 2, 1, 0]"
      }
    ],
    "hiddenTests": [
      {
        "input": "[]\n[\"a\"]",
        "expected": "[0]"
      },
      {
        "input": "[\"test\", \"test\", \"test\"]\n[\"te\", \"test\", \"testing\"]",
        "expected": "[3, 3, 0]"
      },
      {
        "input": "[\"abc\", \"def\"]\n[\"z\", \"abc\"]",
        "expected": "[0, 1]"
      },
      {
        "input": "[\"hello\", \"hell\", \"he\", \"h\"]\n[\"h\", \"he\", \"hel\"]",
        "expected": "[4, 3, 2]"
      },
      {
        "input": "[\"cat\", \"car\", \"dog\"]\n[\"c\", \"ca\", \"d\", \"x\"]",
        "expected": "[2, 2, 1, 0]"
      }
    ],
    "tags": [
      "trie",
      "string"
    ],
    "timeComplexity": "O(total length)",
    "spaceComplexity": "O(total length)",
    "hints": [
      "Build a trie and store at each node how many words pass through it.",
      "Each query is a walk down the trie.",
      "If the walk fails, the answer is 0."
    ]
  },

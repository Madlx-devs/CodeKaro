[
  {
    "id": "count-prefixes-of-a-given-string",
    "title": "Count Prefixes of a Given String",
    "pattern": "tries",
    "difficulty": "Easy",
    "description": "You are given an array of strings words and a string s. Return the number of strings in words that are a prefix of s. Note that s itself counts if it appears in words.",
    "examples": [
      {
        "input": "words = [\"a\",\"b\",\"c\",\"ab\",\"bc\",\"abc\"], s = \"abc\"",
        "output": "3",
        "explanation": "The prefixes of \"abc\" present in words are \"a\", \"ab\" and \"abc\"."
      },
      {
        "input": "words = [\"a\",\"a\"], s = \"aa\"",
        "output": "2",
        "explanation": "Both copies of \"a\" are prefixes of \"aa\"."
      }
    ],
    "constraints": [
      "1 <= words.length <= 1000",
      "1 <= words[i].length, s.length <= 1000"
    ],
    "signature": {
      "className": "Solution",
      "methodName": "countPrefixes",
      "returnType": "int",
      "params": [
        {
          "name": "words",
          "type": "String[]"
        },
        {
          "name": "s",
          "type": "String"
        }
      ]
    },
    "starterCode": "class Solution {\n    public int countPrefixes(String[] words, String s) {\n        return 0;\n    }\n}",
    "sampleTests": [
      {
        "input": "[\"a\", \"b\", \"c\", \"ab\", \"bc\", \"abc\"]\nabc",
        "expected": "3"
      },
      {
        "input": "[\"a\", \"a\"]\naa",
        "expected": "2"
      }
    ],
    "hiddenTests": [
      {
        "input": "[\"a\", \"b\"]\nc",
        "expected": "0"
      },
      {
        "input": "[\"abc\", \"def\"]\nabcdef",
        "expected": "1"
      },
      {
        "input": "[\"x\"]\nx",
        "expected": "1"
      },
      {
        "input": "[\"ab\", \"ab\", \"ab\"]\nabc",
        "expected": "3"
      },
      {
        "input": "[\"a\", \"aa\", \"aaa\"]\naaaa",
        "expected": "3"
      }
    ],
    "tags": [
      "trie",
      "string"
    ],
    "timeComplexity": "O(total length)",
    "spaceComplexity": "O(total length)",
    "hints": [
      "A word w is a prefix of s iff s starts with w.",
      "A trie of words lets you walk along s counting word-ends.",
      "Even a simple loop over words passes the limits."
    ]
  },
  {
    "id": "longest-word-in-dictionary",
    "title": "Longest Word in Dictionary",
    "pattern": "tries",
    "difficulty": "Easy",
    "description": "Given an array of strings words, find the longest word such that every prefix of it is also in words. If several words tie for the longest length, return the lexicographically smallest one.",
    "examples": [
      {
        "input": "words = [\"w\",\"wo\",\"wor\",\"worl\",\"world\"]",
        "output": "world",
        "explanation": "\"world\" qualifies and is the longest."
      },
      {
        "input": "words = [\"a\",\"banana\",\"app\",\"appl\",\"ap\",\"apply\",\"apple\"]",
        "output": "apple",
        "explanation": "Both \"apple\" and \"apply\" qualify; \"apple\" is lexicographically smaller."
      }
    ],
    "constraints": [
      "1 <= words.length <= 1000",
      "1 <= words[i].length <= 30"
    ],
    "signature": {
      "className": "Solution",
      "methodName": "longestWord",
      "returnType": "String",
      "params": [
        {
          "name": "words",
          "type": "String[]"
        }
      ]
    },
    "starterCode": "class Solution {\n    public String longestWord(String[] words) {\n        return \"\";\n    }\n}",
    "sampleTests": [
      {
        "input": "[\"w\", \"wo\", \"wor\", \"worl\", \"world\"]",
        "expected": "world"
      },
      {
        "input": "[\"a\", \"banana\", \"app\", \"appl\", \"ap\", \"apply\", \"apple\"]",
        "expected": "apple"
      }
    ],
    "hiddenTests": [
      {
        "input": "[\"a\", \"b\", \"c\"]",
        "expected": "a"
      },
      {
        "input": "[\"m\", \"mo\", \"moc\", \"moch\", \"mocha\", \"l\", \"la\", \"lat\", \"latt\", \"latte\"]",
        "expected": "latte"
      },
      {
        "input": "[\"t\"]",
        "expected": "t"
      },
      {
        "input": "[\"a\", \"ab\", \"abc\", \"abcd\", \"abcde\"]",
        "expected": "abcde"
      },
      {
        "input": "[\"b\", \"a\", \"ba\"]",
        "expected": "ba"
      }
    ],
    "tags": [
      "trie",
      "string",
      "hash-table"
    ],
    "timeComplexity": "O(total length)",
    "spaceComplexity": "O(total length)",
    "hints": [
      "Put all words in a hash set.",
      "A word qualifies if all its prefixes are in the set.",
      "Track the best by length, breaking ties lexicographically."
    ]
  },

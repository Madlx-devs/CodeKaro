# Copy to .env and fill in. Never commit a real .env with secrets.

# --- App ---
APP_PORT=8080

# --- Database (prod profile; dev profile uses a local H2 file instead) ---
DB_NAME=dsa
DB_USER=dsa
DB_PASSWORD=changeme

# --- Code runner ---
# Docker image used for the sandboxed javac/java containers.
JAVA_RUNNER_IMAGE=eclipse-temurin:17-jdk
# Execution mode: "docker" (default, production) or "local" (dev convenience only).
# "local" ALSO requires ALLOW_LOCAL_EXECUTION=true, otherwise the app refuses to start.
JAVA_RUNNER_MODE=docker
ALLOW_LOCAL_EXECUTION=false

# --- AI assistant (optional) ---
# Without OPENAI_API_KEY, all /api/ai/* endpoints return 503 {"error":"AI not configured"}.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

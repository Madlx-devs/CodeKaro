  {
    "id": "fibonacci-number",
    "title": "Fibonacci Number",
    "pattern": "dynamic-programming",
    "difficulty": "Easy",
    "description": "The Fibonacci numbers are defined as F(0) = 0, F(1) = 1, and F(n) = F(n-1) + F(n-2) for n > 1. Given n, return F(n).",
    "examples": [
      {
        "input": "n = 2",
        "output": "1",
        "explanation": "F(2) = F(1) + F(0) = 1 + 0 = 1."
      },
      {
        "input": "n = 4",
        "output": "3",
        "explanation": "F(4) = F(3) + F(2) = 2 + 1 = 3."
      }
    ],
    "constraints": [
      "0 <= n <= 30"
    ],
    "signature": {
      "className": "Solution",
      "methodName": "fib",
      "returnType": "int",
      "params": [
        {
          "name": "n",
          "type": "int"
        }
      ]
    },
    "starterCode": "class Solution {\n    public int fib(int n) {\n        return 0;\n    }\n}",
    "sampleTests": [
      {
        "input": "2",
        "expected": "1"
      },
      {
        "input": "4",
        "expected": "3"
      }
    ],
    "hiddenTests": [
      {
        "input": "0",
        "expected": "0"
      },
      {
        "input": "1",
        "expected": "1"
      },
      {
        "input": "10",
        "expected": "55"
      },
      {
        "input": "20",
        "expected": "6765"
      },
      {
        "input": "30",
        "expected": "832040"
      }
    ],
    "tags": [
      "dynamic-programming",
      "math"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "hints": [
      "The naive recursion recomputes the same values many times.",
      "Build the answer bottom-up from F(0) and F(1).",
      "You only need the previous two values at any point."
    ]
  },

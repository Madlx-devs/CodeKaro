    "id": "min-cost-climbing-stairs",
    "title": "Min Cost Climbing Stairs",
    "pattern": "dynamic-programming",
    "difficulty": "Easy",
    "description": "You are given an integer array cost where cost[i] is the cost of step i. You can start from step 0 or step 1, and from step i you may climb to step i+1 or i+2 by paying cost[i]. Return the minimum cost to reach the top (one step past the last index).",
    "examples": [
      {
        "input": "cost = [10,15,20]",
        "output": "15",
        "explanation": "Start at step 1, pay 15, then jump two steps to the top."
      },
      {
        "input": "cost = [1,100,1,1,1,100,1,1,100,1]",
        "output": "6",
        "explanation": "The cheapest path costs 6."
      }
    ],
    "constraints": [
      "2 <= cost.length <= 1000",
      "0 <= cost[i] <= 999"
    ],
    "signature": {
      "className": "Solution",
      "methodName": "minCostClimbingStairs",
      "returnType": "int",
      "params": [
        {
          "name": "cost",
          "type": "int[]"
        }
      ]
    },
    "starterCode": "class Solution {\n    public int minCostClimbingStairs(int[] cost) {\n        return 0;\n    }\n}",
    "sampleTests": [
      {
        "input": "[10, 15, 20]",
        "expected": "15"
      },
      {
        "input": "[1, 100, 1, 1, 1, 100, 1, 1, 100, 1]",
        "expected": "6"
      }
    ],
    "hiddenTests": [
      {
        "input": "[0, 0, 0, 0]",
        "expected": "0"
      },
      {
        "input": "[10, 20]",
        "expected": "10"
      },
      {
        "input": "[1, 2]",
        "expected": "1"
      },
      {
        "input": "[5, 10, 15]",
        "expected": "10"
      },
      {
        "input": "[2, 3, 4, 5]",
        "expected": "6"
      }
    ],
    "tags": [
      "dynamic-programming"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "hints": [
      "Let dp[i] be the cheapest cost to reach step i.",
      "dp[i] = min(dp[i-1] + cost[i-1], dp[i-2] + cost[i-2]).",
      "The answer is dp[n]; only two previous values are needed."

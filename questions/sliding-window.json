  {
    "id": "defuse-the-bomb",
    "title": "Defuse the Bomb",
    "pattern": "sliding-window",
    "difficulty": "Easy",
    "description": "You have a circular array code of n integers. To defuse the bomb, replace every number with the sum of the next k numbers if k is positive, the sum of the previous k numbers if k is negative, or 0 if k is zero. The array is circular, so indices wrap around. Return the resulting array.",
    "examples": [
      {
        "input": "code = [5, 7, 1, 4], k = 3",
        "output": "[12, 10, 16, 13]",
        "explanation": "Each element becomes the sum of the next 3 (wrapping around)."
      },
      {
        "input": "code = [1, 2, 3, 4], k = 0",
        "output": "[0, 0, 0, 0]",
        "explanation": "k = 0 replaces everything with 0."
      },
      {
        "input": "code = [2, 4, 9, 3], k = -2",
        "output": "[12, 5, 6, 13]",
        "explanation": "Each element becomes the sum of the previous 2 (wrapping around)."
      }
    ],
    "constraints": [
      "1 <= code.length <= 100",
      "1 <= code[i] <= 100",
      "-100 <= k <= 100"
    ],
    "signature": {
      "className": "Solution",
      "methodName": "decrypt",
      "returnType": "int[]",
      "params": [
        {
          "name": "code",
          "type": "int[]"
        },
        {
          "name": "k",
          "type": "int"
        }
      ]
    },
    "starterCode": "class Solution {\n    public int[] decrypt(int[] code, int k) {\n        \n    }\n}",
    "sampleTests": [
      {
        "input": "[5, 7, 1, 4]\n3",
        "expected": "[12, 10, 16, 13]"
      },
      {
        "input": "[1, 2, 3, 4]\n0",
        "expected": "[0, 0, 0, 0]"
      }
    ],
    "hiddenTests": [
      {
        "input": "[2, 4, 9, 3]\n-2",
        "expected": "[12, 5, 6, 13]"
      },
      {
        "input": "[10, 20, 30]\n1",
        "expected": "[20, 30, 10]"
      },
      {
        "input": "[10, 20, 30]\n-1",
        "expected": "[30, 10, 20]"
      },
      {
        "input": "[1, 2, 3, 4, 5]\n2",
        "expected": "[5, 7, 9, 6, 3]"
      },
      {
        "input": "[3, 1, 2]\n-3",
        "expected": "[6, 6, 6]"
      },
      {
        "input": "[7, 7, 7]\n2",
        "expected": "[14, 14, 14]"
      }
    ],
    "tags": [
      "array",
      "sliding-window"
    ],
    "timeComplexity": "O(n * |k|)",
    "spaceComplexity": "O(n)",
    "hints": [
      "Handle k = 0 as a special case returning all zeros.",
      "For k > 0, index (i + j) % n wraps around the circular array.",
      "A sliding window can compute all sums in O(n), but the direct O(n*|k|) simulation is fine for n <= 100."
    ]
  },

        "output": "12.75",
        "explanation": "Subarray [12, -5, -6, 50] averages 12.75."
      },
      {
        "input": "nums = [5], k = 1",
        "output": "5.0",
        "explanation": "Only one subarray."
      }
    ],
    "constraints": [
      "1 <= k <= nums.length <= 10^5",
      "-10^4 <= nums[i] <= 10^4"
    ],
    "signature": {
      "className": "Solution",
      "methodName": "findMaxAverage",
      "returnType": "double",
      "params": [
        {
          "name": "nums",
          "type": "int[]"
        },
        {
          "name": "k",
          "type": "int"
        }
      ]
    },
    "starterCode": "class Solution {\n    public double findMaxAverage(int[] nums, int k) {\n        \n    }\n}",
    "sampleTests": [
      {
        "input": "[1, 12, -5, -6, 50, 3]\n4",
        "expected": "12.75"
      },
      {
        "input": "[5]\n1",
        "expected": "5.0"
      }
    ],
    "hiddenTests": [
      {
        "input": "[0, 1, 1, 3, 3]\n4",
        "expected": "2.0"
      },
      {
        "input": "[-1]\n1",
        "expected": "-1.0"
      },
      {
        "input": "[4, 2, 1, 3, 3]\n2",
        "expected": "3.0"
      },
      {
        "input": "[1, 2, 3, 4, 5]\n5",
        "expected": "3.0"
      },
      {
        "input": "[-3, -2, -1]\n2",
        "expected": "-1.5"
      },
      {
        "input": "[8, 0]\n2",
        "expected": "4.0"
      }
    ],
    "tags": [
      "array",
      "sliding-window"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "hints": [
      "The average is maximized exactly when the window sum is maximized.",
      "Slide a fixed-size window of length k across the array.",
      "Update the sum in O(1) by adding the new element and subtracting the one that leaves."
    ]

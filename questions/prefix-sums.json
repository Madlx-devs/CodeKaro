      "returnType": "int",
      "params": [
        {
          "name": "nums",
          "type": "int[]"
        }
      ]
    },
    "starterCode": "class Solution {\n    public int pivotIndex(int[] nums) {\n        \n    }\n}",
    "sampleTests": [

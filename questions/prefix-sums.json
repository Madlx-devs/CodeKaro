        "expected": "5"
      },
      {
        "input": "[1]",
        "expected": "0"
      },
      {
        "input": "[1, 1]",
        "expected": "-1"
      },
      {
        "input": "[0, 0, 0]",
        "expected": "0"
      },
      {
        "input": "[-1, -1, -1, -1, -1, 0]",
        "expected": "2"
      }
    ],
    "tags": [
      "array",
      "prefix-sum"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "hints": [

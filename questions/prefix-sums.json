        "input": "nums = [1, 2, 3, 4]",
        "output": "[1, 3, 6, 10]",
        "explanation": "Cumulative sums."
      },
      {
        "input": "nums = [1, 1, 1, 1, 1]",
        "output": "[1, 2, 3, 4, 5]",
        "explanation": "Cumulative sums."
      },
      {
        "input": "nums = [3, 1, 2, 10, 1]",
        "output": "[3, 4, 6, 16, 17]",
        "explanation": "Cumulative sums."
      }
    ],
    "constraints": [
      "1 <= nums.length <= 1000",
      "-10^6 <= nums[i] <= 10^6"
    ],
    "signature": {
      "className": "Solution",
      "methodName": "runningSum",
      "returnType": "int[]",
      "params": [
        {
          "name": "nums",
          "type": "int[]"
        }
      ]
    },
    "starterCode": "class Solution {\n    public int[] runningSum(int[] nums) {\n        \n    }\n}",
    "sampleTests": [
      {
        "input": "[1, 2, 3, 4]",
        "expected": "[1, 3, 6, 10]"
      },
      {
        "input": "[1, 1, 1, 1, 1]",
        "expected": "[1, 2, 3, 4, 5]"
      }
    ],
    "hiddenTests": [
      {
        "input": "[3, 1, 2, 10, 1]",
        "expected": "[3, 4, 6, 16, 17]"
      },
      {
        "input": "[5]",
        "expected": "[5]"
      },
      {
        "input": "[-1, 2, -3, 4]",
        "expected": "[-1, 1, -2, 2]"
      },
      {
        "input": "[0, 0, 0]",
        "expected": "[0, 0, 0]"
      },
      {
        "input": "[10, -10, 10]",
        "expected": "[10, 0, 10]"
      },
      {
        "input": "[2, 4, 6, 8]",
        "expected": "[2, 6, 12, 20]"
      }

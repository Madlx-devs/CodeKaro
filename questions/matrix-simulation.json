    "id": "reshape-the-matrix",
    "title": "Reshape the Matrix",
    "pattern": "matrix-simulation",
    "difficulty": "Easy",
    "description": "Given an m x n matrix mat and integers r and c, reshape it into an r x c matrix preserving the row-traversing order (read the original row by row, fill the new matrix row by row). If the reshape is impossible (m*n != r*c), return the original matrix.",
    "examples": [
      {
        "input": "mat = [[1,2],[3,4]], r = 1, c = 4",
        "output": "[[1, 2, 3, 4]]",
        "explanation": "[[1,2,3,4]]."
      },
      {
        "input": "mat = [[1,2],[3,4]], r = 2, c = 4",
        "output": "[[1, 2], [3, 4]]",
        "explanation": "2*2 != 2*4, so return the original matrix."
      }
    ],
    "constraints": [
      "1 <= m, n <= 100",
      "1 <= r, c <= 300"
    ],
    "signature": {
      "className": "Solution",
      "methodName": "matrixReshape",
      "returnType": "int[][]",
      "params": [
        {
          "name": "mat",
          "type": "int[][]"
        },
        {
          "name": "r",
          "type": "int"
        },
        {
          "name": "c",
          "type": "int"
        }
      ]
    },
    "starterCode": "class Solution {\n    public int[][] matrixReshape(int[][] mat, int r, int c) {\n        return new int[0][0];\n    }\n}",
    "sampleTests": [
      {
        "input": "[[1, 2], [3, 4]]\n1\n4",
        "expected": "[[1, 2, 3, 4]]"
      },
      {
        "input": "[[1, 2], [3, 4]]\n2\n4",
        "expected": "[[1, 2], [3, 4]]"
      }
    ],
    "hiddenTests": [
      {
        "input": "[[1, 2, 3], [4, 5, 6]]\n3\n2",
        "expected": "[[1, 2], [3, 4], [5, 6]]"
      },
      {
        "input": "[[1]]\n1\n1",
        "expected": "[[1]]"
      },
      {
        "input": "[[1, 2], [3, 4], [5, 6]]\n2\n3",
        "expected": "[[1, 2, 3], [4, 5, 6]]"
      },
      {
        "input": "[[1, 2]]\n3\n1",
        "expected": "[[1, 2]]"
      },
      {
        "input": "[[1, 2, 3, 4]]\n2\n2",
        "expected": "[[1, 2], [3, 4]]"
      }
    ],
    "tags": [
      "matrix",
      "array"
    ],
    "timeComplexity": "O(m * n)",
    "spaceComplexity": "O(m * n)",
    "hints": [
      "First check whether m*n equals r*c.",
      "Flatten the matrix into a list, then chunk it into rows of size c.",
      "Index mapping: element k goes to new[k / c][k % c]."
    ]
